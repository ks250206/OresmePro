---
import { Code } from "@astrojs/starlight/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import OpenApp from "./OpenApp.astro";

interface Props {
  code: string;
  image: ImageMetadata;
  alt: string;
}

const { code, image, alt } = Astro.props;
const { lang } = Astro.locals.starlightRoute.entryMeta;
---
<p>
  {lang === "ja"
    ? "File → New Experiment で新しい Experiment を開いてから実行します。"
    : "Choose File → New Experiment before running this example."}
</p>
<OpenApp />
<Code code={code.trimEnd()} lang="python" locale={lang} />
<Image src={image} alt={alt} />
