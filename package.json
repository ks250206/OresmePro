{
  "name": "oresmepro",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-pyodide.mjs && vp dev",
    "build": "node scripts/fetch-pyodide.mjs && tsc -b && vp build",
    "preview": "vp preview",
    "check": "vp check",
    "test": "node scripts/fetch-pyodide.mjs && vp test",
    "e2e": "playwright test",
    "pyodide": "node scripts/fetch-pyodide.mjs",
    "docs:dev": "pnpm --filter @oresmepro/docs dev",
    "docs:build": "pnpm --filter @oresmepro/docs build",
    "docs:preview": "pnpm --filter @oresmepro/docs preview",
    "docs:api": "pnpm --filter @oresmepro/docs api:generate",
    "docs:check": "pnpm --filter @oresmepro/docs api:check && pnpm docs:build && pnpm --filter @oresmepro/docs links:check",
    "pages:build": "pnpm docs:check && pnpm pages:assemble",
    "pages:assemble": "pnpm build --base=/OresmePro/ --outDir=.pages && node docs/scripts/assemble-pages.mjs && python3 docs/scripts/check-links.py --pages .pages",
    "prepare": "vp config"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-web": "0.17.4",
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "pyodide": "314.0.7",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
